# Keep the build context lean: the Dockerfile copies manifests + app sources
# explicitly, so everything heavy or irrelevant stays out of the context.
.git
node_modules
**/node_modules
app/dist
app/test
documentation
infra
scripts
# Only the files the Dockerfile copies for the shipped dashboard build reach the
# context.
dashboard/*
!dashboard/package.json
!dashboard/index.html
!dashboard/vite.config.ts
!dashboard/tsconfig.json
!dashboard/src
# PWA assets (manifest, service worker, icons). Vite copies publicDir to the
# dist root, so WITHOUT this line the in-image build silently produces a dist
# with no manifest and no sw.js - the app then serves the SPA fallback for
# /manifest.webmanifest and /sw.js, the browser can only make a shortcut, and
# push cannot work at all. A LOCAL build hides this completely, because the real
# public/ is present there; only the image build is affected. Cost 2026-08-16.
!dashboard/public
*.md
.env
.env.*
.claude
.dockerignore
docker-compose.yml
