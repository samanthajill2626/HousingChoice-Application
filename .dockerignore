# Keep the build context lean: the Dockerfile copies manifests + app sources
# explicitly, so everything heavy or irrelevant stays out of the context.
.git
node_modules
**/node_modules
app/dist
app/test
documentation
infra
scripts
# Only the files the Dockerfile copies for the shipped dashboard build reach the
# context.
dashboard/*
!dashboard/package.json
!dashboard/index.html
!dashboard/vite.config.ts
!dashboard/tsconfig.json
!dashboard/src
# PWA assets: /app-identity owns the runtime manifest, while public/ owns the
# service worker, notification badge, and both static icon destination families.
# Vite copies public/ to the dist root; omitting it silently drops those shipped
# assets. A local build hides this because the real public/ is present there.
!dashboard/public
*.md
.env
.env.*
.claude
.dockerignore
docker-compose.yml
